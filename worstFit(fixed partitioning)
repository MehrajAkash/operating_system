#include<bits/stdc++.h>
using namespace std;

void worstFit(int blockSize[], int m, int processSize[], int n){
    int allocation[n];
    for(int i=0; i<n; i++)allocation[i]=-1;

    for(int i=0; i<n; i++){
        int bestIndex = -1;
        int blsize = INT_MIN;

        for(int j=0; j<m; j++){
            if( (blockSize[j] >= processSize[i]) && (blockSize[j] > blsize) ){
                bestIndex = j;
                blsize = blockSize[j];
                cout<<blockSize[j]<<endl;
            }
        }
        if(bestIndex != -1){
            allocation[i]=bestIndex;
            blockSize[bestIndex] -= processSize[i];
        }
    }

    cout<<"worstFit allocation"<<endl;
    cout<<"ProcessNo. "<<"ProcessSize "<<"BlockNo"<<endl;
    for(int i=0; i<n; i++){
        cout<<"P"<<i+1<<"\t\t\t"<<processSize[i]<<"\t\t\t";
        if(allocation[i]==-1){
            cout<<"Not allocated"<<endl;
        }else{
            cout<<allocation[i]+1<<endl;
        }
    }
}

int main() 
{
    int blockSize[] = {100, 500, 200, 300, 600};
    int processSize[] = {212, 417, 112, 426};

    int m=5;    //blocknumber
    int n=4;    //processnumber

    worstFit(blockSize, m, processSize, n);

    return 0;
}
