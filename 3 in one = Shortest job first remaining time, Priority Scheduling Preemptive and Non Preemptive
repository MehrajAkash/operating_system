#include <iostream>
#include <vector>
#include <climits>
#include <iomanip>

using namespace std;

struct Process
{
    int pid, at, bt, pr;
    int rt, ct, tat, wt;
    bool completed = false;
};

// =======================
// SJF PREEMPTIVE (SRTF)
// =======================
void sjfPreemptive(vector<Process> p, int n)
{
    int completed = 0, currentTime = 0;

    while (completed < n)
    {
        int idx = -1;
        int minRT = INT_MAX;

        for (int i = 0; i < n; i++)
        {
            if (p[i].at <= currentTime &&
                p[i].rt > 0 &&
                p[i].rt < minRT)
            {
                minRT = p[i].rt;
                idx = i;
            }
        }

        if (idx == -1)
        {
            currentTime++;
            continue;
        }

        p[idx].rt--;
        currentTime++;

        if (p[idx].rt == 0)
        {
            completed++;

            p[idx].ct = currentTime;
            p[idx].tat = p[idx].ct - p[idx].at;
            p[idx].wt = p[idx].tat - p[idx].bt;
        }
    }

    cout << "\n===== SJF PREEMPTIVE (SRTF) =====\n";

    double avgTAT = 0, avgWT = 0;

    cout << "--------------------------------------------------\n";
    cout << "PID\tAT\tBT\tCT\tTAT\tWT\n";
    cout << "--------------------------------------------------\n";

    for (auto x : p)
    {
        cout << "P" << x.pid << "\t"
             << x.at << "\t"
             << x.bt << "\t"
             << x.ct << "\t"
             << x.tat << "\t"
             << x.wt << endl;

        avgTAT += x.tat;
        avgWT += x.wt;
    }

    cout << "--------------------------------------------------\n";

    cout << fixed << setprecision(2);
    cout << "\nAverage Turnaround Time = " << avgTAT / n << endl;
    cout << "Average Waiting Time = " << avgWT / n << endl;
}

// =======================
// PRIORITY PREEMPTIVE
// =======================
void priorityPreemptive(vector<Process> p, int n)
{
    int completed = 0, currentTime = 0;

    while (completed < n)
    {
        int idx = -1;
        int highestPriority = INT_MAX;

        for (int i = 0; i < n; i++)
        {
            if (p[i].at <= currentTime &&
                p[i].rt > 0 &&
                p[i].pr < highestPriority)
            {
                highestPriority = p[i].pr;
                idx = i;
            }
        }

        if (idx == -1)
        {
            currentTime++;
            continue;
        }

        p[idx].rt--;
        currentTime++;

        if (p[idx].rt == 0)
        {
            completed++;

            p[idx].ct = currentTime;
            p[idx].tat = p[idx].ct - p[idx].at;
            p[idx].wt = p[idx].tat - p[idx].bt;
        }
    }

    cout << "\n===== PRIORITY PREEMPTIVE =====\n";

    double avgTAT = 0, avgWT = 0;

    cout << "-----------------------------------------------------------\n";
    cout << "PID\tAT\tBT\tPR\tCT\tTAT\tWT\n";
    cout << "-----------------------------------------------------------\n";

    for (auto x : p)
    {
        cout << "P" << x.pid << "\t"
             << x.at << "\t"
             << x.bt << "\t"
             << x.pr << "\t"
             << x.ct << "\t"
             << x.tat << "\t"
             << x.wt << endl;

        avgTAT += x.tat;
