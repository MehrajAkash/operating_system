#include <bits/stdc++.h>
using namespace std;

void nextFit(int blockSize[], int m, int processSize[], int n)
{
    int allocation[n];

    for(int i=0;i<n;i++)
        allocation[i]=-1;

    int j=0;   // Current block index

    for(int i=0;i<n;i++)
    {
        int count=0;

        while(count<m)
        {
            if(blockSize[j] >= processSize[i])
            {
                allocation[i]=j;
                blockSize[j]-=processSize[i];
                break;
            }

            j=(j+1)%m;   // Move to next block (circular)
            count++;
        }
    }

    cout<<"Next Fit Allocation\n";
    cout<<"Process\tSize\tBlock\n";

    for(int i=0;i<n;i++)
    {
        cout<<"P"<<i+1<<"\t"<<processSize[i]<<"\t";

        if(allocation[i]==-1)
            cout<<"Not Allocated";
        else
            cout<<allocation[i]+1;

        cout<<endl;
    }
}

int main()
{
    int blockSize[]={100,500,200,300,600};
    int processSize[]={212,417,426,112};

    nextFit(blockSize,5,processSize,4);
}
