#include <iostream>//cout, cin, end
#include <vector>//
#include <algorithm>//sort() এবং min()
#include <iomanip>//setw()

using namespace std;

struct Process {
    int pid;
    int at, bt;
    int priority;
    int ct = 0, tat = 0, wt = 0;
};

// ---------------- GANTT CHART ----------------
void printGantt(const vector<int>& gantt) {

    cout << "\nGantt Chart:\n|";

    for (int x : gantt) {
        if (x == -1)
            cout << " Idle |";
        else
            cout << " P" << x << " |";
    }

    cout << "\n0";

    for (int i = 1; i <= gantt.size(); i++)
        cout << setw(5) << i;

    cout << endl;
}


// ---------------- RESULT ----------------
void printResult(vector<Process>& p) {
    float totalWT = 0, totalTAT = 0;

    cout << "\nPID\tAT\tBT\tCT\tTAT\tWT\n";

    for (auto& x : p) {
        x.tat = x.ct - x.at;
        x.wt = x.tat - x.bt;

        totalWT += x.wt;
        totalTAT += x.tat;

        cout << "P" << x.pid << '\t'
             << x.at << '\t'
             << x.bt << '\t'
             << x.ct << '\t'
             << x.tat << '\t'
             << x.wt << '\n';
    }

    cout << "\nAverage WT = " << totalWT / p.size();
    cout << "\nAverage TAT = " << totalTAT / p.size() << '\n';
}

// ---------------- PRIORITY PREEMPTIVE ----------------
void priorityPreemptive(vector<Process> p) {
    int n = p.size();

int time = 0;
int completed = 0;
vector<int> remainingBT(n);
vector<int> gantt;

for (int i = 0; i < n; i++)
    remainingBT[i] = p[i].bt;

    while (completed < n) {

        int idx = -1;

        // Find highest priority process
        for (int i = 0; i < n; i++) {

            if (p[i].at <= time && remainingBT[i] > 0) {

                if (idx == -1)
                    idx = i;

                else if (p[i].priority < p[idx].priority)
                    idx = i;

                else if (p[i].priority == p[idx].priority &&
                         remainingBT[i] < remainingBT[idx])
                    idx = i;
            }
        }

        // CPU Idle
        if (idx == -1) {
            gantt.push_back(-1);
            time++;
            continue;
        }

        // Execute for 1 second
        gantt.push_back(p[idx].pid);
        remainingBT[idx]--;
        time++;

        if (remainingBT[idx] == 0) {
            p[idx].ct = time;
            completed++;
        }
    }


    printGantt(gantt);
    printResult(p);
}

// ---------------- MAIN ----------------
int main() {
    int n;

    cout << "Enter number of processes: ";
    cin >> n;

    vector<Process> p(n);

    for (int i = 0; i < n; i++) {

        p[i].pid = i + 1;

        cout << "\nProcess P" << i + 1 << '\n';

        cout << "Arrival Time: ";
        cin >> p[i].at;

        cout << "Burst Time: ";
        cin >> p[i].bt;

        cout << "Priority: ";
        cin >> p[i].priority;
    }


    priorityPreemptive(p);

    return 0;
}
