#include <iostream>
#include <vector>
#include <climits>
#include <iomanip>

using namespace std;

struct Process
{
    int pid, at, bt, pr;
    int rt, ct, tat, wt;
};

int main()
{
    int n;

    cout << "Enter number of processes: ";
    cin >> n;

    vector<Process> p(n);

    // Input
    for (int i = 0; i < n; i++)
    {
        p[i].pid = i + 1;

        cout << "\nEnter Arrival Time for P" << i + 1 << ": ";
        cin >> p[i].at;

        cout << "Enter Burst Time for P" << i + 1 << ": ";
        cin >> p[i].bt;

        cout << "Enter Priority for P" << i + 1 << ": ";
        cin >> p[i].pr;

        p[i].rt = p[i].bt;
    }

    int completed = 0, currentTime = 0;

    // Preemptive Priority Scheduling
    while (completed < n)
    {
        int idx = -1;
        int highestPriority = INT_MAX;

        // Find highest priority process
        // Smaller number = Higher priority
        for (int i = 0; i < n; i++)
        {
            if (p[i].at <= currentTime &&
                p[i].rt > 0 &&
                p[i].pr < highestPriority)
            {
                highestPriority = p[i].pr;
                idx = i;
            }
        }

        // No process available
        if (idx == -1)
        {
            currentTime++;
            continue;
        }

        // Execute for 1 unit
        p[idx].rt--;
        currentTime++;

        // Process completed
        if (p[idx].rt == 0)
        {
            completed++;

            p[idx].ct = currentTime;
            p[idx].tat = p[idx].ct - p[idx].at;
            p[idx].wt = p[idx].tat - p[idx].bt;
        }
    }

    // Output
    cout << "\n-----------------------------------------------------------\n";
    cout << "PID\tAT\tBT\tPR\tCT\tTAT\tWT\n";
    cout << "-----------------------------------------------------------\n";

    double avgTAT = 0, avgWT = 0;

    for (auto x : p)
    {
        cout << "P" << x.pid << "\t"
             << x.at << "\t"
             << x.bt << "\t"
             << x.pr << "\t"
             << x.ct << "\t"
             << x.tat << "\t"
             << x.wt << endl;

        avgTAT += x.tat;
        avgWT += x.wt;
    }

    cout << "-----------------------------------------------------------\n";

    cout << fixed << setprecision(2);

    cout << "\nAverage Turnaround Time = "
         << avgTAT / n << endl;

    cout << "Average Waiting Time = "
         << avgWT / n << endl;

    return 0;
}


